{
    "formatters": {
        "formatter": {
            "format": "${timestamp} ${level} ${logger} [${thread}] ${function}(${file}:${line}): ${message}"
        }
    },
    "handlers": {
        "console-handler": {
            "type": "console",
            "stream": "stdout",
            "formatter": "formatter"
        },
        "file-handler": {
            "type": "file",
            "file": "log.txt",
            "size": 1024,
            "formatter": "formatter"
        }
    },
    "loggers": {
        "root": {
            "level": 6,
            "handlers": [
                "console-handler",
                "file-handler"
            ]
        }
    }
}
