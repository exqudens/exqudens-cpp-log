{
    "formatters": {
        "formatter": {
            "format": "${timestamp} ${level} ${logger} [${thread}] ${function}(${file}:${line}): ${message}",
            "parameters": {
                "timestamp": {"format": 1, "seconds": 8, "size": 5, "reverse": true}
            }
        }
    },
    "handlers": {
        "console": {
            "type": "console",
            "level": 6,
            "stream": "stdout",
            "formatter": "formatter"
        },
        "file": {
            "type": "file",
            "level": 6,
            "file": "log.txt",
            "size": 1024,
            "formatter": "formatter"
        }
    },
    "loggers": {
        "root": {
            "level": 1,
            "handlers": [
                "console",
                "file"
            ]
        },
        "abc": {
            "handlers": [
                "console"
            ]
        }
    }
}
